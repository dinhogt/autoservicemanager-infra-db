aws_region   = "us-east-1"
project_name = "autoservicemanager"
environment  = "homolog"

# Senha do RDS é gerada por random_password — não versionar segredos.
# db_allowed_cidr_blocks = []  # default; break-glass only

# Fase 4: billing e execution usam tabelas independentes PAY_PER_REQUEST.
# Defaults: billing PK/SK + GSI1(GSI1PK) + TTL expiresAt; execution pk/sk + TTL ttl.
# dynamodb_point_in_time_recovery = true
